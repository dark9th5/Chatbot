# ============================================================================
# Cấu hình LLM Provider - GROQ ONLY
# ============================================================================
# Hiện tại project chỉ hỗ trợ Groq (nhanh nhất, miễn phí)

LLM_PROVIDER=groq

# Groq API Key - Lấy tại: https://console.groq.com/keys
# Free tier: 30 req/min (đủ cho demo/testing)
GROQ_API_KEY=gsk_your_key_here

# Model options:
# - mixtral-8x7b-32768 (default, nhanh nhất, ~100ms/response)
# - llama2-70b-4096 (mạnh nhất, chậm hơn)
# - gemma-7b-it (siêu nhẹ, siêu nhanh)
GROQ_MODEL=mixtral-8x7b-32768

# ============================================================================
# Cấu hình Fallback LLM (Tùy chọn)
# ============================================================================
# HuggingFace API Key - Lấy tại: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_key_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2


# ============================================================================
# Database Configuration (Tùy chọn - SQLite là default)
# ============================================================================

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=chatbot_db

# ============================================================================
# Qdrant Vector Database Configuration
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ============================================================================
# FastAPI Server Configuration
# ============================================================================
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_PORT=8000
RSS_REFRESH_LIMIT=15
RSS_REFRESH_WORKERS=5

# ============================================================================
# Web Admin Security
# ============================================================================
# ADMIN_PASSWORD chỉ dùng để seed tài khoản khi bảng admin_users chưa có user.
# Sau khi chạy lần đầu, có thể đổi mật khẩu bằng scripts/create_admin.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
JWT_SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_TOKEN_EXPIRE_MINUTES=480
ADMIN_COOKIE_SECURE=false

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
